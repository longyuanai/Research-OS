# Keep governance and implementation artifacts byte-stable across platforms.
# Default: let Git detect text files and store/check them out with LF.
* text=auto eol=lf

.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf
*.txt text eol=lf
LICENSE text eol=lf
FOUNDATION/VERSION text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.sh text eol=lf

# Windows-native scripts need CRLF in the working tree (cmd.exe label
# lookup is unreliable with LF-only batch files). The index still stores LF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Common binary artifacts must never be newline-normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.pyc binary
