# Keep governance and implementation artifacts byte-stable across platforms.
.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf
LICENSE text eol=lf
FOUNDATION/VERSION text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.sh text eol=lf

# Common binary artifacts must never be newline-normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
